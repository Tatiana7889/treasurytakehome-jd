{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Ocr": {
    "TessDataPath": "./tessdata",
    "Language": "eng",
    "MinimumConfidence": 0.55
  },
  "LabelReview": {
    "MaxUploadSizeMb": 15,
    "AllowedFileTypes": [ ".jpg", ".jpeg", ".png", ".pdf" ],
    "BatchMaxItems": 100,
    "FuzzyMatchThreshold": 0.85
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  }
}
