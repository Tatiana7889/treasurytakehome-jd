# ---- Build stage ----
    FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
    WORKDIR /src
    
    # Copy csproj and restore
    COPY Ttb.LabelReview.Api.csproj .
    RUN dotnet restore Ttb.LabelReview.Api.csproj
    
    # Copy everything and publish
    COPY . .
    RUN dotnet publish -c Release -o /app/publish /p:UseAppHost=false
    
    # ---- Runtime stage ----
    FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
    
    # Install full Tesseract + Leptonica dependency chain
    RUN apt-get update && apt-get install -y --no-install-recommends \
            tesseract-ocr \
            tesseract-ocr-eng \
            libleptonica-dev \
            libtesseract-dev \
            libjpeg62-turbo \
            libpng16-16 \
            libtiff5 \
            libwebp7 \
            libopenjp2-7 \
            zlib1g \
            libglib2.0-0 \
            libsm6 \
            libxext6 \
            libxrender1 \
        && rm -rf /var/lib/apt/lists/*
    
    WORKDIR /app
    COPY --from=build /app/publish .
    
    ENV ASPNETCORE_ENVIRONMENT=Development
    ENV ASPNETCORE_URLS=http://+:8080
    EXPOSE 8080
    
    ENTRYPOINT ["dotnet", "Ttb.LabelReview.Api.dll"]
    